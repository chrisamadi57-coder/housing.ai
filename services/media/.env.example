#Storage
STORAGE_BACKEND=local
UPLOAD_DIR=./uploads


# Gpa verification
GPS_MAX_DISTANCE_METERS=100

# Redis / Celery
REDIS_URL=redis://localhost:6379/0

# Object storage (S3-compatible: R2, AWS, B2, MinIO)
STORAGE_BACKEND=local
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=housing-media
S3_REGION=auto


# OpenAI (leave blank to use rule-based parser)
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=